# Server configuration
# All values are optional — defaults shown below.

# Address to listen on (default: :8000)
# LISTEN=:8000

# Base directory for srv/templates, srv/static, and uploads/
# Default: directory containing the executable
# BASE_DIR=/path/to/my-travels

# Log directory for daily log files (optional — logs also go to stderr/journalctl)
# Files are named YYYY-MM-DD.log and appended to throughout the day.
# LOG_DIR=./logs

# Google OAuth 2.0 (optional — app works without authentication)
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-your-secret

# Email of the admin user. The admin sees the /admin dashboard and can
# impersonate other users. There is no default: leave it unset and the
# instance has no admin.
# ADMIN_EMAIL=admin@example.com

# Number of trusted reverse proxies in front of the app (default: 1).
# Used to pick the client IP out of X-Forwarded-For for comment rate
# limiting. Set 0 if the app is reachable directly, 2 for CDN + nginx, etc.
# TRUSTED_PROXY_HOPS=1
